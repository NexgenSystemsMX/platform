# Docker ignore file for Huly Frontend build
# This file excludes unnecessary files from the Docker build context

# Git
.git
.gitignore
.gitattributes
.github

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# Node modules (will be installed fresh in container)
**/node_modules
**/.rush

# Build artifacts (will be generated in container)
**/lib
**/types
**/dist
**/bundle
**/*.tsbuildinfo

# Test snapshots and data
**/sanity-ws
**/sanity-ws-qms
**/*.gz

# Documentation
docs
*.md
!README.md

# Desktop packages (not needed for web frontend)
desktop-package
qms-desktop-package

# Local environment files
**/.env
**/.env.local
**/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp
temp
*.tmp
*.temp
